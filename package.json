  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kyomufs/dsh-opencode-zen.git"
  },
  "homepage": "https://github.com/kyomufs/dsh-opencode-zen",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "opencode",
    "zen",
    "free",
    "llm",
    "provider",
    "disguise",
    "cli-headers",
    "quota",
